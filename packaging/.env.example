# Copy to `.env` next to flowchartmaker.exe (or the repo root in dev) and fill in.

# Which LLM to use: "gemini" (packaged/prod default) or "ollama" (local, free)
LLM_PROVIDER=gemini

# Required when LLM_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Used when LLM_PROVIDER=ollama (Ollama must be running)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_VISION_MODEL=llava
